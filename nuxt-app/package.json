{
  "name": "discoverystack-nuxt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3000",
    "dev:nuxt": "nuxt dev --host 0.0.0.0 --port 3000",
    "build": "nuxt build",
    "preview": "nuxt preview --host 0.0.0.0 --port 3000",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:safe": "pnpm typecheck && NODE_OPTIONS=--max-old-space-size=4096 NITRO_PRESET=node-server pnpm build && NODE_OPTIONS=--max-old-space-size=4096 NITRO_PRESET=node-server vitest run",
    "test:external-credentials": "DS_RUN_EXTERNAL_CREDENTIAL_TESTS=1 vitest run tests/provider-secrets.integration.test.ts tests/huggingface.credentials.test.ts tests/huggingface-namespace-secret.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:check-identifiers": "node scripts/mysql-identifier-policy.mjs",
    "prepare": "nuxt prepare"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.693.0",
    "@aws-sdk/s3-request-presigner": "^3.693.0",
    "axios": "^1.19.0",
    "better-sqlite3": "^12.5.0",
    "drizzle-orm": "^0.45.2",
    "h3": "1.15.11",
    "jose": "^6.2.9",
    "mysql2": "^3.23.3",
    "nuxt": "4.5.2",
    "sharp": "0.34.3",
    "tldts": "7.4.11",
    "vue-router": "^5.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "5.9.3",
    "vitest": "4.0.18",
    "vue-tsc": "3.3.10"
  }
}
