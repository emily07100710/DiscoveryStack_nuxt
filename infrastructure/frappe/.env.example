# Local disposable stack only. Copy outside Git and inject real values at runtime.
FRAPPE_SITE_NAME=system-factory.localhost
FRAPPE_DB_ROOT_PASSWORD=
FRAPPE_ADMIN_PASSWORD=
FRAPPE_HMAC_KEY_REFERENCE=
FRAPPE_INTERNAL_RECEIVER_ID=discovery-stack-frappe
DISCOVERYSTACK_INTERNAL_SENDER_ID=discoverystack-nuxt
FRAPPE_FACTORY_IMAGE=discoverystack/frappe-system-factory:v1-local
# Nuxt server-only live boundary. Values are injected by the runtime secret manager.
SYSTEM_FACTORY_CONTROL_PLANE_LIVE_ENABLED=false
SYSTEM_FACTORY_TENANT_APP_LIVE_ENABLED=false
SYSTEM_FACTORY_FRAPPE_ORIGIN=
SYSTEM_FACTORY_FRAPPE_ALLOWED_ORIGINS=
SYSTEM_FACTORY_HMAC_CREDENTIAL_REF=
SYSTEM_FACTORY_HMAC_KEY_ID=
SYSTEM_FACTORY_HMAC_SECRET=
SYSTEM_FACTORY_FRAPPE_AUTHORIZATION=
SYSTEM_FACTORY_RUNTIME_AUTHORITY_FINGERPRINT=
SYSTEM_FACTORY_CUSTOM_APP_SHA256=
SYSTEM_FACTORY_BUILD_RECIPE_FINGERPRINT=
SYSTEM_FACTORY_IMAGE_MANIFEST_DIGEST=
SYSTEM_FACTORY_IMAGE_CONFIG_DIGEST=
SYSTEM_FACTORY_RUNTIME_PRODUCTION_APPROVED=false
