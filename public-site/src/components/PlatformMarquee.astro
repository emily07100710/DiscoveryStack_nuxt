---
import { platformDirectory, platformDirectoryCount, platformDirectoryGroups } from '../lib/platform-directory'
import type { IntegrationLocale } from '../lib/integration-platforms'
import '../styles/platform-carousel.css'
interface Props { locale?: IntegrationLocale }
const { locale = 'zh-hant' } = Astro.props
const isZh = locale === 'zh-hant'
const brands = platformDirectoryGroups.flatMap(group => group.brands.map(key => ({ key, ...platformDirectory[key] })))
---

<section class="platform-marquee" data-platform-carousel data-locale={locale} aria-label={isZh ? '可規劃 API 串接的平台' : 'Platforms available for API integration planning'}>
  <div class="platform-marquee-heading">
    <p>CONNECTED TO YOUR EVERYDAY / {platformDirectoryCount}</p>
    <h2>{isZh ? '你每天用的平台，該一起幫你做生意。' : 'Make the platforms you use work together.'}</h2>
    <p class="platform-marquee-intro">{isZh ? '40 個平台，放在同一個生意裡。指向一個 Logo，看看你的下一步能接上什麼。' : 'Forty platforms in one connected business. Point at a logo to explore the next connection.'}</p>
  </div>
  <div class="platform-carousel-shell">
    <div class="platform-directory" data-platform-stage aria-label={isZh ? '可旋轉的四十個平台 Logo' : 'Rotating cloud of forty platform logos'}>
      <div class="platform-cloud-orbit platform-cloud-orbit--one" aria-hidden="true"></div>
      <div class="platform-cloud-orbit platform-cloud-orbit--two" aria-hidden="true"></div>
      <span class="platform-cloud-core" aria-hidden="true">DISCOVERY<br />STACK</span>
      <ul class="platform-grid" data-platform-cloud>
        {brands.map((brand, index) => <li data-platform-card data-brand-index={index} data-brand-name={brand.name}>
          <a class={`platform-logo platform-logo-${brand.key}`} href={brand.website} target="_blank" rel="noopener noreferrer" draggable="false" aria-label={isZh ? `${brand.name} 官方網站` : `${brand.name} official website`}>
            <span class={`platform-mark platform-mark-${brand.key}`} aria-hidden="true">{brand.asset ? <img src={brand.asset} alt="" width={brand.key === 'line' ? 44 : 36} height={brand.key === 'line' ? 44 : 36} loading="lazy" decoding="async" draggable="false" /> : <span class="platform-monogram">{'mark' in brand ? brand.mark : ''}</span>}</span>
            <strong>{brand.name}</strong>
          </a>
        </li>)}
      </ul>
      <span class="platform-cloud-caption" aria-hidden="true">{isZh ? '網站・訊息・物流・金流・客戶管理' : 'WEB · MESSAGING · SHIPPING · PAYMENTS · CRM'}</span>
    </div>
    <div class="platform-carousel-controls">
      <p class="platform-carousel-current"><span>{isZh ? '指向 Logo 暫停轉動' : 'HOVER TO PAUSE'}</span><strong data-platform-name>{isZh ? '40 個平台，一起運作' : 'Forty platforms, one connected world'}</strong></p>
      <button type="button" class="platform-carousel-pause" data-platform-pause aria-pressed="false" data-pause-label={isZh ? '暫停轉動' : 'Pause rotation'} data-resume-label={isZh ? '繼續轉動' : 'Resume rotation'}><span aria-hidden="true">Ⅱ</span><span data-platform-pause-text>{isZh ? '暫停轉動' : 'Pause rotation'}</span></button>
    </div>
    <span class="platform-carousel-status" data-platform-status aria-live="polite" aria-atomic="true"></span>
  </div>
  <div class="platform-next-step"><p>{isZh ? '你正在用哪些平台？告訴我們，直接規劃怎麼接。' : 'Which platforms do you use? Tell us and plan the next connection.'}</p><a href={isZh ? '/zh-hant#fit' : '/en#fit'}>{isZh ? '談我的整合需求' : 'Discuss my integrations'}<span aria-hidden="true">↗</span></a></div>
</section>

<script>
  import { initPlatformCarousel } from '../lib/platform-carousel'
  const setup = () => {
    document.querySelectorAll<HTMLElement>('[data-platform-carousel]').forEach(root => {
      if (root.dataset.carouselReady) return
      const cleanup = initPlatformCarousel(root)
      document.addEventListener('astro:before-swap', cleanup, { once: true })
    })
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup, { once: true })
  else setup()
  document.addEventListener('astro:page-load', setup)
</script>

<style>
  .platform-marquee { padding: clamp(3rem, 6vw, 5.5rem) 0; border-top: 1px solid rgba(23,26,50,.12); color: var(--premium-navy); background: var(--premium-paper); }
  .platform-marquee-heading, .platform-carousel-shell, .platform-next-step { max-width: 1440px; margin-inline: auto; padding-inline: var(--gutter); }
  .platform-marquee-heading > p:first-child { margin: 0 0 1rem; color: #746d60; font: .58rem/1.5 var(--font-mono, monospace); letter-spacing: .15em; }
  .platform-marquee-heading h2 { margin: 0; font: 400 clamp(1.5rem, 2.6vw, 2.65rem)/1.35 var(--font-display, sans-serif); letter-spacing: -.04em; }
  .platform-marquee-intro { max-width: 42rem; margin: 1rem 0 0; color: #716d68; font: .85rem/1.8 var(--font-body, sans-serif); }
  .platform-next-step { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-top: 2.6rem; padding-top: 1.5rem; border-top: 1px solid rgba(23,26,50,.2); }
  .platform-next-step p { margin: 0; font: 500 clamp(.85rem, 1.25vw, 1.1rem)/1.5 var(--font-body, sans-serif); }
  .platform-next-step a { display: inline-flex; align-items: center; gap: 1.75rem; flex-shrink: 0; color: var(--premium-navy); font: 500 .8rem/1.4 var(--font-body, sans-serif); text-decoration: none; border-bottom: 1px solid currentColor; padding-block: .5rem; }
  .platform-next-step a span { transition: transform var(--motion-feedback, 200ms); }
  .platform-next-step a:hover span, .platform-next-step a:focus-visible span { transform: translate(3px, -3px); }
  .platform-next-step a:focus-visible { outline: 2px solid var(--premium-navy); outline-offset: 3px; }
  @media (max-width: 700px) { .platform-next-step { align-items: flex-start; flex-direction: column; } }
  @media (prefers-reduced-motion: reduce) { .platform-next-step a span { transition-duration: 0ms; } }
</style>
