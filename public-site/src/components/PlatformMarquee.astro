---
import { platformDirectory, platformDirectoryCount, platformDirectoryGroups } from '../lib/platform-directory'
import type { IntegrationLocale } from '../lib/integration-platforms'
interface Props { locale?: IntegrationLocale }
const { locale = 'zh-hant' } = Astro.props
const isZh = locale === 'zh-hant'
---

<section class="platform-marquee" aria-label={isZh ? '可規劃 API 串接的平台' : 'Platforms available for API integration planning'}>
  <div class="platform-marquee-heading">
    <p>CONNECTED TO YOUR EVERYDAY / {platformDirectoryCount}</p>
    <h2>{isZh ? '你熟悉的平台，都在這裡。' : 'The platforms you already know.'}</h2>
    <p class="platform-marquee-intro">{isZh ? `從網站、訊息到物流、金流與客戶管理，探索 ${platformDirectoryCount} 個可規劃 API 串接的平台。` : `Explore ${platformDirectoryCount} platforms available for API integration planning, from websites and messaging to shipping, payments and customer relationships.`}</p>
  </div>
  <div class="platform-directory">
    {platformDirectoryGroups.map((group, groupIndex) => <div class="platform-group">
      <h3><span>0{groupIndex + 1}</span>{group.title[locale]}<small>{group.brands.length.toString().padStart(2, '0')}</small></h3>
      <ul class="platform-grid">
        {group.brands.map(key => { const brand = platformDirectory[key]; return <li>
          <a class={`platform-logo platform-logo-${key}`} href={brand.website} target="_blank" rel="noopener noreferrer" aria-label={isZh ? `${brand.name} 官方網站` : `${brand.name} official website`}>
            <span class={`platform-mark platform-mark-${key}`} aria-hidden="true">{brand.asset ? <img src={brand.asset} alt="" width={key === 'line' ? 44 : 36} height={key === 'line' ? 44 : 36} loading="lazy" decoding="async" /> : <span class="platform-monogram">{'mark' in brand ? brand.mark : key.slice(0, 2).toUpperCase()}</span>}</span>
            <strong>{brand.name}</strong><span class="platform-arrow" aria-hidden="true">↗</span>
          </a>
        </li> })}
      </ul>
    </div>)}
  </div>
  <p class="platform-brand-note">{isZh ? '以上為可規劃的 API 串接方向，實際串接依授權、地區與專案範圍確認。品牌標誌與名稱僅供平台識別，不代表合作關係或品牌背書；部分平台以名稱縮寫呈現。' : 'These are API integration options for project scoping; availability depends on access, region and scope. Brand marks and names identify platforms and do not imply partnership or endorsement. Some are shown with initials.'}</p>
</section>

<style>
  .platform-marquee { padding: clamp(3rem, 6vw, 5.5rem) 0; border-top: 1px solid rgba(23,26,50,.12); color: var(--premium-navy); background: var(--premium-paper); }
  .platform-marquee-heading, .platform-directory, .platform-brand-note { max-width: 1440px; margin-inline: auto; padding-inline: var(--gutter); }
  .platform-marquee-heading > p:first-child { margin: 0 0 1rem; color: #746d60; font: .58rem/1.5 var(--font-mono, monospace); letter-spacing: .15em; }
  .platform-marquee-heading h2 { margin: 0; font: 400 clamp(1.5rem, 2.6vw, 2.65rem)/1.35 var(--font-display, sans-serif); letter-spacing: -.04em; }
  .platform-marquee-intro { max-width: 42rem; margin: 1rem 0 0; color: #716d68; font: .85rem/1.8 var(--font-body, sans-serif); }
  .platform-directory { display: grid; gap: 2.2rem; margin-top: 3.2rem; }
  .platform-group h3 { display: flex; align-items: center; gap: 1rem; margin: 0 0 .65rem; color: var(--premium-navy); font: 500 clamp(.85rem, 1.2vw, 1rem)/1.4 var(--font-display, sans-serif); }
  .platform-group h3 > span { color: #827866; font: .62rem/1 var(--font-mono, monospace); }
  .platform-group h3 > small { margin-left: auto; color: #827866; font: .56rem/1 var(--font-mono, monospace); }
  .platform-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 1.5rem; margin: 0; padding: 0; list-style: none; }
  .platform-grid li { min-width: 0; border-top: 1px solid rgba(23,26,50,.15); }
  .platform-logo { position: relative; display: flex; align-items: center; gap: .75rem; min-height: 5.25rem; padding: .8rem .45rem .8rem .1rem; color: inherit; text-decoration: none; transition: background var(--motion-feedback, 200ms), padding-left var(--motion-feedback, 200ms); }
  .platform-logo::before { content: ''; position: absolute; inset: -1px 0 auto; height: 1px; background: var(--premium-metal, #b9a477); transform: scaleX(0); transform-origin: left; transition: transform var(--motion-panel, 360ms) var(--motion-ease, ease-out); }
  .platform-logo:hover, .platform-logo:focus-visible { background: rgba(183,168,143,.09); padding-left: .5rem; }
  .platform-logo:hover::before, .platform-logo:focus-visible::before { transform: scaleX(1); }
  .platform-logo:focus-visible { outline: 2px solid var(--premium-navy); outline-offset: 2px; }
  .platform-mark { display: grid; place-items: center; flex: 0 0 42px; width: 42px; height: 42px; }
  .platform-mark img { display: block; width: 36px; height: 36px; object-fit: contain; }
  .platform-mark-line img { width: 44px; height: 44px; }
  .platform-mark-dhl { flex-basis: 60px; width: 60px; height: 36px; background: #ffcc00; }
  .platform-mark-dhl img { width: 56px; height: 34px; }
  .platform-monogram { display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid rgba(23,26,50,.4); color: var(--premium-navy); font: 600 .66rem/1 var(--font-mono, monospace); letter-spacing: -.04em; }
  .platform-logo strong { min-width: 0; font: 500 .81rem/1.25 var(--font-body, sans-serif); overflow-wrap: anywhere; }
  .platform-arrow { margin-left: auto; color: #89806f; font-size: .9rem; transition: transform var(--motion-feedback, 200ms); }
  .platform-logo:hover .platform-arrow, .platform-logo:focus-visible .platform-arrow { transform: translate(3px, -3px); }
  .platform-brand-note { margin-top: 2.6rem; color: #777168; font: .64rem/1.7 var(--font-body, sans-serif); }
  @media (max-width: 1100px) { .platform-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 700px) { .platform-directory { gap: 1.8rem; margin-top: 2.4rem; } .platform-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 .75rem; } .platform-logo { min-height: 4.75rem; gap: .45rem; } .platform-mark { flex-basis: 36px; width: 36px; height: 36px; } .platform-mark img { width: 31px; height: 31px; } .platform-mark-line img { width: 40px; height: 40px; } .platform-mark-dhl { flex-basis: 44px; width: 44px; height: 29px; } .platform-mark-dhl img { width: 42px; height: 27px; } .platform-logo strong { font-size: .68rem; } .platform-arrow { display: none; } .platform-brand-note { font-size: .58rem; } }
  @media (prefers-reduced-motion: reduce) { .platform-logo, .platform-logo::before, .platform-arrow { transition-duration: 0ms; } }
</style>
