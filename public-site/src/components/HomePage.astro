---
import AutomaticSiteAnalysis from './AutomaticSiteAnalysis.vue'
import FitReviewFormIsland from './FitReviewFormIsland.vue'
import ParticleSculpture from './ParticleSculpture.vue'
import IntegrationEcosystem from './IntegrationEcosystem.astro'
import PlatformMarquee from './PlatformMarquee.astro'
import SearchDiscoveryExplainer from './SearchDiscoveryExplainer.astro'
import LearningEngine from './LearningEngine.astro'
import ServiceSignal from './ServiceSignal.astro'
import WebsiteStudioTeaser from './WebsiteStudioTeaser.astro'
import SceneSeam from './SceneSeam.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { publicSiteOrigin } from '../lib/publicApi'
import { homeJsonLd } from '../lib/site'
interface Props { locale: 'en' | 'zh-hant' }
const { locale } = Astro.props
const isZh = locale === 'zh-hant'
const base = `/${locale}`
const builder = '/zh-hant/website-builder-preview'
const title = isZh ? '亞洲唯一 GEO 機器學習，讓品牌成為首選' : 'GEO machine learning with 100,000+ real-world data points'
const description = isZh ? '客戶正在問 Google，也正在問 AI。DiscoveryStack 以亞洲唯一 GEO 機器學習串起品牌網站、搜尋觀察與持續改善，讓你的品牌先被看見、再被選擇。' : 'GEO machine learning built on more than 100,000 real-world data points. DiscoveryStack connects websites, search observations and continuous improvement so your brand can be found and understood.'
const services = isZh ? [
  { n: '01', name: '品牌與網站', en: 'BRAND & WEB', line: '客戶只看幾秒，就決定要不要找你。', text: '網站看不懂、手機不好用，客戶就會點開下一家。你的對手，可能只差一個更好用的網站，就接走這筆生意。', risk: '你不把價值說清楚，客戶就只能比價格。', solution: '把服務、可信的證據與詢問入口排好，讓客戶看懂你，也知道下一步怎麼找你。', tags: ['看得懂服務', '信得過品牌', '找得到你'], cta: '開始打造我的網站', target: builder },
  { n: '02', name: '搜尋與成長', en: 'SEARCH & GROWTH', line: 'AI 正在推薦品牌。下一個是你，還是對手？', text: '客戶把需求丟給 Google 與 AI，答案裡沒有你，對手就先被看見。別再等排名掉了、詢問少了，才回頭補救。', risk: '你不先把品牌放進答案裡，對手就會先占住位置。', solution: '用亞洲唯一 GEO 機器學習連接搜尋訊號、內容與網站改善，找出下一步最值得搶的機會。', tags: ['亞洲唯一 GEO 機器學習', 'SEO / GEO', '持續觀察與改善'], cta: '看我們如何搶先一步', target: '#learning-engine' },
  { n: '03', name: '行銷與策略', en: 'MARKETING & STRATEGY', line: '廣告有人點，最後卻找了別家？', text: '你花錢把人帶進來，卻沒有讓他看懂、相信、願意詢問。對手可能沒有多花預算，只是讓客戶更容易採取下一步。', risk: '流量買得到，客戶的信任要接得住。', solution: '把廣告、內容與詢問流程接起來，找到客戶在哪裡離開，再把那一步做好。', tags: ['行銷方向', '廣告與內容', '詢問流程'], cta: '找出我的成交卡點', target: '#fit' },
  { n: '04', name: '系統與整合', en: 'SYSTEMS & INTEGRATION', line: '生意開始進來，後台不能還靠手抄。', text: '訊息散在不同地方、訂單重複輸入、客戶等不到回覆。當對手已經把流程接好，你還在忙著找資料。', risk: '少一次漏單、少一次等待，客戶就多一個留下的理由。', solution: '先確認平台、授權與可用範圍，再安排網站與營運系統的串接。', tags: ['會員與預約', '金流與訂單', '客戶管理'], cta: '看整合服務', target: '#integrations' },
  { n: '05', name: 'AI 與自動化', en: 'AI & AUTOMATION', line: '同樣一天 24 小時，對手已經開始省時間。', text: '常見問題一直回答、資料一直整理，重要的客戶卻等不到你。把重複工作交給合適的工具，你才有時間把生意做好。', risk: '不是誰用更多 AI，而是誰更早把時間省下來。', solution: '從客服知識、內容整理到日常流程，先做真正用得到的自動化，讓人員保留最後的決定權。', tags: ['知識問答', '內容整理', '工作流程'], cta: '聊聊能省下哪些工作', target: '#fit' },
] : [
  { n: '01', name: 'Brand & Web', en: 'BRAND & WEB', line: 'A few seconds can decide who gets the enquiry.', text: 'If your website is confusing or difficult on a phone, the next business is one click away. A clearer experience can make your competitor the easier choice.', risk: 'When your value is unclear, price becomes the comparison.', solution: 'Make services, real evidence and the next step easy to understand, so visitors know why to choose you.', tags: ['Clear services', 'Credible proof', 'Easy enquiries'], cta: 'Build my website', target: builder },
  { n: '02', name: 'Search & Growth', en: 'SEARCH & GROWTH', line: 'AI is naming brands. Will yours be next?', text: 'Customers ask Google and AI before they choose. If your brand is missing from the answer, a competitor gets seen first. Do not wait for enquiries to fall before you act.', risk: 'Give AI a reason to understand your brand before competitors own the conversation.', solution: 'Our GEO machine learning connects search signals, content and website improvements to find the next opportunity worth pursuing.', tags: ['100,000+ real-world data points', 'SEO / GEO', 'Continuous improvement'], cta: 'See how we move first', target: '#learning-engine' },
  { n: '03', name: 'Marketing & Strategy', en: 'MARKETING & STRATEGY', line: 'Clicks arrive. Enquiries go somewhere else?', text: 'Bringing people in is only the beginning. A competitor may win with the same budget simply by making the next step clearer.', risk: 'Attention can be bought. Trust has to be earned.', solution: 'Connect campaigns, content and enquiry paths. Find where people leave, then improve that moment.', tags: ['Direction', 'Campaigns & content', 'Enquiry paths'], cta: 'Find the friction', target: '#fit' },
  { n: '04', name: 'Systems & Integration', en: 'SYSTEMS & INTEGRATION', line: 'Your business is growing. Your admin should keep up.', text: 'Scattered messages, duplicate entry and slow replies cost time. Your competitor may already have the workflow connected while you are still finding the information.', risk: 'One fewer missed order. One less reason to leave.', solution: 'Confirm platforms, authorisations and available features, then plan the connections around your business.', tags: ['Membership & booking', 'Payments & orders', 'Customer management'], cta: 'Explore integrations', target: '#integrations' },
  { n: '05', name: 'AI & Automation', en: 'AI & AUTOMATION', line: 'The same 24 hours. A smarter use of them.', text: 'Repeated questions and manual organisation leave less time for customers. Put the repeatable work into useful tools and keep people in charge of the decisions.', risk: 'The advantage is time saved, not the number of AI tools.', solution: 'Start with practical knowledge tools, content preparation and daily workflows that your team can actually use.', tags: ['Knowledge', 'Content preparation', 'Daily workflows'], cta: 'Find time worth saving', target: '#fit' },
]
const steps = isZh ? [
  { n: '01', title: '先理解', body: '聊目標、看現況，找到值得先做的事。' },
  { n: '02', title: '一起設計', body: '確認方向、範圍與預算，再把細節做好。' },
  { n: '03', title: '持續改善', body: '依方案觀察搜尋與 AI 呈現，安排修改與驗證，累積下一步的依據。' },
] : [
  { n: '01', title: 'Understand', body: 'Start with your goals, your context and the right priorities.' },
  { n: '02', title: 'Create', body: 'Agree on direction, scope and budget. Then make every detail count.' },
  { n: '03', title: 'Improve', body: 'Observe search and AI discovery, review changes and check the results within your agreed service scope.' },
]
const prices = isZh ? [
  { title: '品牌官網', note: '客製設計與開發', price: '78,800', unit: '起', detail: '依頁數、內容與功能確認範圍，採階段付款。電商、會員與預約等功能另行評估。' },
  { title: 'SEO／GEO 成長', note: '搜尋、內容與持續優化', price: '28,800', unit: '／月起', detail: '先建立基準與優先序，再按月檢查進度。不保證搜尋排名、AI 引用或營收。' },
  { title: '人工深度診斷', note: '先釐清問題，再決定方向', price: '8,800', unit: '／次', detail: '30 天內進入後續合作可全額折抵。先由人員檢查網站與需求，再確認值得優先處理的問題。' },
] : [
  { title: 'Brand website', note: 'Custom design & development', price: '78,800', unit: 'from', detail: 'Scope follows pages, content and features, with milestone payments. Commerce, membership and booking are scoped separately.' },
  { title: 'SEO / GEO growth', note: 'Search, content & optimisation', price: '28,800', unit: '/ month from', detail: 'Begin with a baseline and priorities, then review monthly. Search rankings, AI citations and revenue are not guaranteed.' },
  { title: 'Human-led diagnosis', note: 'Find the problem and the right direction', price: '8,800', unit: '/ review', detail: 'Fully credited when a project starts within 30 days. We review your site and brief before recommending priorities.' },
]
---
<BaseLayout locale={locale} title={title} description={description} canonicalPath={base} jsonLd={homeJsonLd(locale, title, description, publicSiteOrigin)}>
  <article class="premium-home">
    <section class="premium-hero" aria-labelledby="heroTitle">
      <div class="premium-hero-art"><ParticleSculpture client:load locale={locale} /></div>
      <div class="shell premium-hero-inner">
        <div class="premium-hero-copy">
          <p class="premium-kicker" data-reveal><span class="premium-signal"></span> {isZh ? 'ASIA’S ONLY GEO MACHINE LEARNING' : 'GEO MACHINE LEARNING / REAL-WORLD DATA'}</p>
          <h1 id="heroTitle">{isZh ? <><span class="premium-title-line"><span data-hero-line>亞洲唯一</span></span><span class="premium-title-line"><span class="premium-title-accent" data-hero-line>GEO 機器學習</span></span></> : <><span class="premium-title-line"><span data-hero-line>100,000+ real-world</span></span><span class="premium-title-line"><span data-hero-line>data points.</span></span><span class="premium-title-line"><span class="premium-title-accent" data-hero-line>GEO machine learning.</span></span></>}</h1>
          <p class="premium-hero-deck" data-reveal>{isZh ? '客戶已經開始問 AI，對手也正搶著出現在答案裡。' : 'Customers are asking AI. Your competitors want to be the answer.'}<br />{isZh ? '把網站、搜尋與機器學習接起來，讓你的品牌先被看見、再被選擇。' : 'Connect your website, search and machine learning so your brand gets seen and chosen.'}</p>
          <div class="premium-actions" data-reveal><a class="premium-button" href={builder} data-magnetic>{isZh ? '開始一鍵建站' : 'Start my website'}<span aria-hidden="true">↗</span></a><a class="premium-link" href="#analysis">{isZh ? '免費找出網站弱點' : 'Find my website’s weak spots'}<span aria-hidden="true">→</span></a></div>
        </div>
        <div class="premium-hero-bottom"><a href="#departments" class="premium-scroll">SCROLL TO DISCOVER <span aria-hidden="true">↓</span></a><span class="premium-art-caption">CRAFTED IN EVERY DIMENSION / 01</span></div>
      </div>
    </section>
    <div class="premium-discipline-band" aria-label={isZh ? '整合服務' : 'Our disciplines'}><div class="shell"><span>STRATEGY</span><i aria-hidden="true">✳</i><span>DESIGN</span><i aria-hidden="true">✳</i><span>TECHNOLOGY</span><i aria-hidden="true">✳</i><span>GROWTH</span></div></div>
    <section class="premium-services shell" id="departments">
      <header class="premium-section-header"><p class="premium-kicker" data-reveal>01 / YOUR NEXT ADVANTAGE</p><div data-reveal data-reveal-kind="title"><h2>{isZh ? '客戶不會等你準備好。' : 'Customers will not wait.'}<br /><span>{isZh ? '你的對手，也不會。' : 'Neither will your competitors.'}</span></h2><p>{isZh ? '點開看看，哪一步正在讓你的生意錯過客戶。' : 'Open a discipline. Find the opportunity your business could be missing.'}</p></div></header>
      <SearchDiscoveryExplainer locale={locale} />
      <div class="premium-service-list">{services.map((service, index) => <details class="premium-service" name="premium-services" open={index === 0} data-service data-reveal data-reveal-kind="line">
        <summary><span class="premium-service-number">{service.n}</span><h3>{service.name}</h3><span class="premium-service-en">{service.en}</span><span class="premium-service-toggle" aria-hidden="true">+</span></summary>
        <div class="premium-service-detail">
          <ServiceSignal index={service.n} />
          <div class="premium-service-copy"><p class="premium-service-question">{isZh ? '為什麼現在就該做？' : 'WHY NOW?'}</p><h4>{service.line}</h4><p>{service.text}</p>
            <div class="premium-service-payoff"><strong>{service.risk}</strong><p>{service.solution}</p></div>
            <ul class="premium-service-benefits">{service.tags.map(tag => <li><span aria-hidden="true">↗</span>{tag}</li>)}</ul>
            <a class="premium-link" href={service.target}>{service.cta}<span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </details>)}</div>
    </section>
    <SceneSeam target=".premium-analysis" tone="khaki" />
    <div class="premium-analysis"><AutomaticSiteAnalysis client:visible locale={locale} /></div>
    <SceneSeam target="#website-studio" tone="paper" direction={-1} />
    <WebsiteStudioTeaser locale={locale} />
    <SceneSeam target="#integrations" tone="deep" />
    <IntegrationEcosystem locale={locale} />
    <LearningEngine locale={locale} />
    <section class="premium-process shell" id="journey"><header class="premium-section-header"><p class="premium-kicker" data-reveal>05 / HOW WE WORK</p><h2 data-reveal>{isZh ? '把複雜交給我們。' : 'Leave the complexity with us.'}<br /><span>{isZh ? '把方向握在手裡。' : 'Keep the direction in your hands.'}</span></h2></header><div class="premium-process-list" data-reveal-stagger>{steps.map(step => <article data-reveal data-reveal-kind="card"><span>{step.n}</span><h3>{step.title}</h3><p>{step.body}</p></article>)}</div><a class="premium-link" href={`${base}/methodology/journey-intelligence`}>{isZh ? '看看我們的方法' : 'Our approach'}<span aria-hidden="true">↗</span></a></section>
    <section class="premium-pricing shell" id="pricing"><header class="premium-section-header"><p class="premium-kicker" data-reveal>06 / A CLEAR START</p><div data-reveal data-reveal-kind="title"><h2>{isZh ? '好合作，從清楚開始。' : 'Good work begins with clarity.'}</h2><p>{isZh ? '以下為未稅起價。確認需求後，提供範圍與正式報價。' : 'Starting prices before tax. A clear scope and quote follow your brief.'}</p></div></header><div class="premium-price-list" data-reveal-stagger>{prices.map(price => <details data-reveal data-reveal-kind="line" data-shell-details><summary><div><h3>{price.title}</h3><p>{price.note}</p></div><div class="premium-price"><small>NT$</small><strong>{price.price}</strong><span>{price.unit}</span></div><span aria-hidden="true">+</span></summary><div class="premium-price-detail"><p>{price.detail}</p><a href="#fit" class="premium-link">{isZh ? '聊聊需求' : 'Discuss your brief'}<span aria-hidden="true">↗</span></a></div></details>)}</div></section>
    <section class="premium-contact shell" id="fit" data-ambient><div class="premium-contact-intro" data-reveal data-reveal-kind="title"><p class="premium-kicker">LET’S MAKE SOMETHING MATTER.</p><h2>{isZh ? '下一步，' : 'Your next chapter.'}<br /><span>{isZh ? '一起做好。' : 'Let’s make it count.'}</span></h2><p>{isZh ? '告訴我們你的想法。從一次好好對話開始。' : 'Tell us what you have in mind. It starts with a conversation.'}</p><span class="premium-contact-signature">DiscoveryStack<br /><small>STRATEGY · DESIGN · TECHNOLOGY</small></span></div><div class="premium-contact-form" data-reveal data-reveal-kind="soft"><FitReviewFormIsland client:visible locale={locale} /></div></section>
    <PlatformMarquee locale={locale} />
  </article>
</BaseLayout>
